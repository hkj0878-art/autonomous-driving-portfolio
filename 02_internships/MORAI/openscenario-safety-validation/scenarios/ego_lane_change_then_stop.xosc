<?xml version="1.0" encoding="utf-8"?>
<!-- OpenSCENARIO 1.0 example; requires map and simulator configuration -->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="0" date="2025-02-05T00:00:00" description="Lane change followed by stop (example)" author="portfolio example"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="egoSpeed" parameterType="double" value="10.0"/>
    <ParameterDeclaration name="ego_event_enabled" parameterType="boolean" value="true"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="../MGeo"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="2023_Hyundai_Ioniq5" vehicleCategory="car">
        <ParameterDeclarations/>
        <BoundingBox><Center x="1.3" y="0.0" z="0.9"/><Dimensions width="1.8" length="4.5" height="1.5"/></BoundingBox>
        <Performance maxSpeed="40" maxAcceleration="3.0" maxDeceleration="6.0"/>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="3.0" positionZ="0.3"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.3"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><WorldPosition x="0.0" y="0.0" z="0" h="0" p="0" r="0"/></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction>
            <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
            <SpeedActionTarget><AbsoluteTargetSpeed value="$egoSpeed"/></SpeedActionTarget>
          </SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="DriverInitiatedLaneChange">
      <ParameterDeclarations/>
      <Act name="Ego_act">
        <ManeuverGroup name="Ego_group" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego"/></Actors>
          <Maneuver name="Ego_maneuver">
            <Event name="Ego_lanechange" priority="overwrite">
              <Action name="lane_change_action"><PrivateAction><LateralAction>
                <LaneChangeAction>
                  <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="3" dynamicsDimension="time"/>
                  <LaneChangeTarget><RelativeTargetLane entityRef="Ego" value="1"/></LaneChangeTarget>
                </LaneChangeAction>
              </LateralAction></PrivateAction></Action>
              <StartTrigger><ConditionGroup>
                <Condition name="timer_2_seconds" delay="0" conditionEdge="rising">
                  <ByValueCondition><SimulationTimeCondition value="2" rule="greaterThan"/></ByValueCondition>
                </Condition>
                <Condition name="event_enabled" delay="0" conditionEdge="none">
                  <ByValueCondition><ParameterCondition parameterRef="ego_event_enabled" value="true" rule="equalTo"/></ByValueCondition>
                </Condition>
              </ConditionGroup></StartTrigger>
            </Event>
            <Event name="Ego_stop" priority="overwrite">
              <Action name="ego_decelerate"><PrivateAction><LongitudinalAction><SpeedAction>
                <SpeedActionDynamics dynamicsShape="linear" value="2.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="0.0"/></SpeedActionTarget>
              </SpeedAction></LongitudinalAction></PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="after_lanechange" delay="0" conditionEdge="rising">
                <ByValueCondition><StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="Ego_lanechange" state="completeState"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger><ConditionGroup><Condition name="act_start" delay="0" conditionEdge="rising">
          <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
        </Condition></ConditionGroup></StartTrigger>
      </Act>
    </Story>
    <StopTrigger><ConditionGroup><Condition name="stop_after_time" delay="0" conditionEdge="rising">
      <ByValueCondition><SimulationTimeCondition value="40" rule="greaterThan"/></ByValueCondition>
    </Condition></ConditionGroup></StopTrigger>
  </Storyboard>
</OpenSCENARIO>
