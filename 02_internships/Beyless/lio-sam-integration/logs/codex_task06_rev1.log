#!/usr/bin/env python3
"""Independently validate Nav2 PGM/YAML, dimensions, counts and provenance."""
import argparse
import hashlib
import json
from pathlib import Path
import numpy as np
from PIL import Image
import yaml

ROOT = Path(__file__).resolve().parents[2]
MIN_TRAJECTORY_FREE_FRACTION = 0.8


def read_pgm(path):
    with Path(path).open('rb') as f:
        def line():
            while True:
                s = f.readline()
                if not s:
                    raise ValueError('Truncated PGM header')
                s = s.split(b'#', 1)[0].strip()
                if s:
                    return s
        if line() != b'P5':
            raise ValueError('Expected binary PGM P5')
        width, height = map(int, line().split())
        if width <= 0 or height <= 0 or line() != b'255':
            raise ValueError('Invalid PGM dimensions/maxval')
        raw = f.read()
        if len(raw) != width * height:
            raise ValueError('PGM payload size mismatch')
    pixels = np.frombuffer(raw, dtype=np.uint8).reshape(height,width)
    if not set(np.unique(pixels)).issubset({0,205,254}):
        raise ValueError('PGM contains invalid trinary values')
    return pixels


def nav2_decode(gray, meta):
    """Humble map_io.cpp trinary equations, for opaque grayscale PGM."""
    shade = np.asarray(gray, dtype=float) / 255.0
    occ = shade if meta['negate'] else 1.0 - shade
    return np.where(occ > meta['occupied_thresh'], 100,
                    np.where(occ < meta['free_thresh'], 0, -1))


def validate(directory, check_sources=True):
    directory = Path(directory)
    meta = yaml.safe_load((directory/'map2d.yaml').read_text())
    required = {'image','resolution','origin','negate','occupied_thresh','free_thresh','mode'}
    if required - meta.keys():
        raise ValueError('Missing Nav2 YAML fields')
    if (meta['image'] != 'map2d.pgm' or meta['mode'] != 'trinary' or meta['negate'] != 0
            or meta['resolution'] != .05 or meta['occupied_thresh'] != .65 or meta['free_thresh'] != .25):
        raise ValueError('Unexpected Nav2 YAML parameters')
    if len(meta['origin']) != 3 or not np.isfinite(meta['origin']).all() or meta['origin'][2] != 0:
        raise ValueError('Invalid origin')
    pixels = read_pgm(directory/meta['image'])
    compatible = yaml.safe_load((directory/'map2d_nav2.yaml').read_text())
    if compatible != dict(meta, free_thresh=0.196):
        raise ValueError('Unexpected companion Nav2 YAML parameters')
    values = np.array([0,254,205],dtype=np.uint8)
    if nav2_decode(values,compatible).tolist() != [100,0,-1]:
        raise ValueError('Nav2 unknown/free/occupied round-trip mismatch')
    stats = json.loads((directory/'map2d_stats.json').read_text())
    if pixels.shape != (stats['height_cells'],stats['width_cells']):
        raise ValueError('PGM/stats dimension mismatch')
    np.testing.assert_allclose(np.array(pixels.shape[::-1]) * meta['resolution'], stats['size_m'], atol=1e-9)
    np.testing.assert_allclose(meta['origin'][:2], stats['origin'], atol=1e-9)
    np.testing.assert_allclose(np.array(meta['origin'][:2])/meta['resolution'], np.round(np.array(meta['origin'][:2])/meta['resolution']), atol=1e-8)
    for name, value in [('occupied',0),('free',254),('unknown',205)]:
        if np.count_nonzero(pixels==value) != stats['cells'][name] or stats['cells'][name] == 0:
            raise ValueError(f'Wrong/empty {name} count')
    # Cross-check projected occupancy against the known final path. This detects
    # a vertical PGM flip even if file sizes/counts are otherwise valid.
    if check_sources:
        poses = np.loadtxt(ROOT/'results'/stats['run']/'keyframes_final_tum.txt')
        ij = np.floor((poses[:,1:3]-meta['origin'][:2])/meta['resolution']).astype(int)
        if np.any(ij < 0) or np.any(ij[:,0] >= pixels.shape[1]) or np.any(ij[:,1] >= pixels.shape[0]):
            raise ValueError('Trajectory outside grid bounds')
        path_values = pixels[pixels.shape[0]-1-ij[:,1],ij[:,0]]
        stats['trajectory_cells_free_fraction'] = float(np.mean(path_values == 254))
        if stats['trajectory_cells_free_fraction'] < MIN_TRAJECTORY_FREE_FRACTION:
            raise ValueError('Trajectory/free-space mismatch: check PGM orientation and origin')
        for path, expected in stats['source_sha256'].items():
            h = hashlib.sha256()
            with (ROOT/path).open('rb') as f:
                for block in iter(lambda:f.read(1024*1024),b''):
                    h.update(block)
            if h.hexdigest() != expected:
                raise ValueError(f'Source modified: {path}')
        if (directory/'map_full.pcd').read_bytes() != (ROOT/'results'/stats['run']/'map/GlobalMap.pcd').read_bytes():
            raise ValueError('Full map differs from source')
        import open3d as o3d
        cloud = o3d.io.read_point_cloud(str(directory/'map_0p10.pcd'))
        if len(cloud.points) != stats['voxel_points']:
            raise ValueError('Voxel PCD point count mismatch')
        for name in ('map_top.png','map_oblique.png','map2d.png'):
            with Image.open(directory/name) as image:
                if min(image.size) < 1000 or np.asarray(image).std() < 5:
                    raise ValueError(f'Empty/low resolution image: {name}')
    return dict(valid=True, pgm_shape=list(pixels.shape), origin=meta['origin'],
                resolution=meta['resolution'], cells=stats['cells'],
                nav2_load_yaml='map2d_nav2.yaml', nav2_semantics_valid=True,
                requested_yaml_preserves_unknown=False,
                requested_yaml_note='free_thresh 0.25 decodes gray 205 as free; use map2d_nav2.yaml (0.196).',
                trajectory_cells_free_fraction=stats.get('trajectory_cells_free_fraction'))


if __name__ == '__main__':
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('directory', type=Path)
    args = p.parse_args()
    result = validate(args.directory)
    (args.directory/'validation.json').write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps(result,indent=2))
"""Streaming voxel map with pose SLERP, scan parity and acquisition-time provenance.

No per-point deskew: each scan uses its header pose. relative_time_s and stamp_s
are voxel means (not original individual returns). count weights allow incremental
voxel aggregation without changing centroids. Input bags and trajectories are read-only.
"""
import argparse
from pathlib import Path
import numpy as np
from scipy.spatial.transform import Rotation, Slerp
from rclpy.serialization import deserialize_message
from sensor_msgs.msg import PointCloud2
from .gnss_gt import bag_reader
from .traj_eval import load_tum

VOXEL_M = 0.1
MERGE_EVERY_SCANS = 20
MAX_VOXELS = 3_000_000


def voxel_reduce(rows, voxel=VOXEL_M):
    """Nx6: xyz, relative-time, header-stamp, weight. Weighted voxel means."""
    if voxel<=0: raise ValueError('Voxel size must be positive')
    if not len(rows): return np.empty((0,6))
    keys=np.floor(rows[:,:3]/voxel).astype(np.int64)
    _, inverse=np.unique(keys,axis=0,return_inverse=True)
    n=int(inverse.max())+1
    if n>MAX_VOXELS: raise MemoryError(f'Voxel budget exceeded ({n}); increase voxel size')
    weights=np.bincount(inverse,weights=rows[:,5],minlength=n)
    means=np.column_stack([np.bincount(inverse,weights=rows[:,k]*rows[:,5],minlength=n)/weights for k in range(5)])
    return np.column_stack((means,weights))


def cloud_rows(msg):
    names=['x','y','z','time']; fields={f.name:f for f in msg.fields}
    if not set(names)<=fields.keys(): raise ValueError('Cloud missing xyz/time')
    if any(fields[n].datatype!=7 or fields[n].count!=1 for n in names): raise ValueError('Expected float32 xyz/time')
    endian='>' if msg.is_bigendian else '<'
    dt=np.dtype(dict(names=names,formats=[endian+'f4']*4,
                     offsets=[fields[n].offset for n in names],itemsize=msg.point_step))
    a=np.ndarray((msg.height,msg.width),dtype=dt,buffer=msg.data,strides=(msg.row_step,msg.point_step)).reshape(-1)
    xyz=np.column_stack([a[n] for n in names[:3]])
    mask=np.isfinite(xyz).all(axis=1)&np.isfinite(a['time'])&(np.linalg.norm(xyz,axis=1)>0)
    return xyz[mask],a['time'][mask]


def build_map(bag, trajectory, scan_filter='all', voxel=VOXEL_M, windows=None, alignment=None):
    if scan_filter not in ('all','even','odd'): raise ValueError('Invalid scan filter')
    trajectory=np.asarray(trajectory)
    interp=Slerp(trajectory[:,0], Rotation.from_quat(trajectory[:,4:]))
    reader=bag_reader(bag,['/points_raw'])
    windows=windows or [(float(trajectory[0,0]),float(trajectory[-1,0]))]
    accumulated=[np.empty((0,6)) for _ in windows]; pending=[[] for _ in windows]
    scanned=0; used=[0]*len(windows)
    while reader.has_next():
        _,raw,_=reader.read_next()
        index=scanned; scanned+=1
        if scan_filter!='all' and index%2 != (0 if scan_filter=='even' else 1): continue
        msg=deserialize_message(raw,PointCloud2)
        t=msg.header.stamp.sec+msg.header.stamp.nanosec*1e-9
        if t<trajectory[0,0] or t>trajectory[-1,0]: continue
        targets=[i for i,(lo,hi) in enumerate(windows) if lo<=t<=hi]
        if not targets: continue
        xyz,relative=cloud_rows(msg)
        rotation=interp([t]).as_matrix()[0]
        translation=np.array([np.interp(t,trajectory[:,0],trajectory[:,k]) for k in range(1,4)])
        xyz=xyz@rotation.T+translation
        if alignment is not None:
            r,trans=alignment; xyz=xyz@np.asarray(r).T+np.asarray(trans)
        rows=voxel_reduce(np.column_stack((xyz,relative,np.full(len(xyz),t),np.ones(len(xyz)))),voxel)
        for i in targets:
            pending[i].append(rows); used[i]+=1
            if len(pending[i])>=MERGE_EVERY_SCANS:
                accumulated[i]=voxel_reduce(np.concatenate([accumulated[i],*pending[i]]),voxel); pending[i]=[]
    for i in range(len(windows)):
        if pending[i]: accumulated[i]=voxel_reduce(np.concatenate([accumulated[i],*pending[i]]),voxel)
        if not len(accumulated[i]): raise ValueError(f'No scans covered window {windows[i]}')
    return accumulated,dict(scans_read=scanned,scans_used=used,voxel_m=voxel,scan_filter=scan_filter,
                            deskew=False,relative_time='voxel weighted mean of original scan-relative seconds')


if __name__=='__main__':
    p=argparse.ArgumentParser(); p.add_argument('--bag',required=True); p.add_argument('--traj',required=True)
    p.add_argument('--out',required=True); p.add_argument('--scan-filter',choices=['all','even','odd'],default='all')
    p.add_argument('--voxel',type=float,default=VOXEL_M)
    a=p.parse_args(); maps,meta=build_map(a.bag,load_tum(a.traj),a.scan_filter,a.voxel)
    import json
    target=Path(a.out); target.parent.mkdir(parents=True,exist_ok=True)
    np.savez_compressed(target,xyz=maps[0][:,:3],relative_time_s=maps[0][:,3],stamp_s=maps[0][:,4],count=maps[0][:,5],metadata=json.dumps(meta))
import json
from pathlib import Path
import sys
import numpy as np
import pytest
import yaml

sys.path.insert(0, str(Path(__file__).parents[1]))
from maps.export_maps import Config, GroundModel, obstacle_mask, bresenham_batch, write_grid
from maps.verify_maps import validate, read_pgm, nav2_decode


def test_local_ground_removes_floor_and_high_returns():
    cfg = Config()
    points = []
    for x,z in [(0.,0.),(2.,1.)]:
        points.extend([[x+.1+i*.01,.1,z] for i in range(30)])
        points.extend([[x+.1,.1,z+.5],[x+.1,.1,z+2.5]])
    points = np.array(points)
    ground = GroundModel(points,cfg)
    mask = obstacle_mask(points,ground,cfg)
    assert np.flatnonzero(mask).tolist() == [30,62]
    np.testing.assert_allclose(ground.at(np.array([[.5,.5,0],[2.5,.5,0]])), [0,1])


def test_bresenham_stops_at_wall_and_leaves_unobserved_unknown():
    blocked = np.zeros((7,8),bool); blocked[2,4] = True
    free, hit = set(), set()
    for f,h in bresenham_batch([1,2],[[6,2]],blocked.shape,blocked):
        free.update(f); hit.update(h)
    assert free == {2*8+2,2*8+3}
    assert hit == {2*8+4}
    assert 2*8+5 not in free
    assert 2*8+1 not in free


@pytest.mark.parametrize('end',[[1,1],[6,1],[1,6],[6,6],[2,6],[6,2],[3,3]])
def test_bresenham_all_octants_and_endpoint(end):
    blocked = np.zeros((8,8),bool)
    visited = []
    for f,h in bresenham_batch([3,3],[end],blocked.shape,blocked):
        assert not len(h)
        visited.extend(f.tolist())
    assert len(visited) == max(abs(end[0]-3),abs(end[1]-3))
    if end != [3,3]:
        assert visited[-1] == end[1]*8+end[0]


def fixture_grid(tmp_path):
    pixels = np.array([[254,254,205],[0,205,205]],np.uint8)
    cfg = Config(); origin = [-.1,.2]
    write_grid(tmp_path,pixels,origin,cfg)
    stats = dict(width_cells=3,height_cells=2,size_m=[.15,.1],origin=origin,
                 cells=dict(occupied=1,free=2,unknown=3))
    (tmp_path/'map2d_stats.json').write_text(json.dumps(stats))
    return pixels


def test_nav2_yaml_pgm_and_vertical_orientation(tmp_path):
    pixels = fixture_grid(tmp_path)
    np.testing.assert_array_equal(read_pgm(tmp_path/'map2d.pgm'), pixels[::-1])
    assert validate(tmp_path,check_sources=False)['valid']
    meta = yaml.safe_load((tmp_path/'map2d.yaml').read_text())
    assert meta['origin'] == [-.1,.2,0.]


def test_validator_rejects_corrupt_pgm(tmp_path):
    fixture_grid(tmp_path)
    with (tmp_path/'map2d.pgm').open('ab') as f:
        f.write(b'x')
    with pytest.raises(ValueError,match='payload'):
        validate(tmp_path,check_sources=False)


def test_validator_rejects_wrong_resolution(tmp_path):
    fixture_grid(tmp_path)
    path = tmp_path/'map2d.yaml'
    meta = yaml.safe_load(path.read_text()); meta['resolution'] = .1
    path.write_text(yaml.safe_dump(meta))
    with pytest.raises(ValueError,match='parameters'):
        validate(tmp_path,check_sources=False)


def test_nav2_roundtrip_and_spec_threshold_conflict(tmp_path):
    fixture_grid(tmp_path)
    requested = yaml.safe_load((tmp_path/'map2d.yaml').read_text())
    compatible = yaml.safe_load((tmp_path/'map2d_nav2.yaml').read_text())
    values = np.array([0,254,205])
    assert nav2_decode(values,requested).tolist() == [100,0,0]
    assert nav2_decode(values,compatible).tolist() == [100,0,-1]
