    ax.set(xlabel='Time since first GNSS fix (s)',ylabel='Horizontal SE3 ATE (m)',title='Final keyframe position errors');ax.legend(ncol=3,fontsize=8);save_fig(fig,figs/'ate_vs_time.png')
    fig,axes=plt.subplots(1,2,figsize=(11,4)); x=np.arange(4)
    for mode,color,shift in [('on','#0072B2',-.18),('off','#D55E00',.18)]:
        for ax,field,title in [(axes[0],'translation_percent','Translation (%)'),(axes[1],'yaw_deg_per_100m','Yaw (deg/100 m)')]:
            values=np.array([[all_metrics[f'loop_{mode}_r{i}']['final']['rpe'][str(length)][field]['mean'] for length in (10,25,50,100)] for i in (1,2,3)])
            ax.bar(x+shift,values.mean(axis=0),.36,yerr=values.std(axis=0,ddof=1),color=color,label=f'Loop {mode}')
            ax.set_xticks(x,['10','25','50','100']);ax.set(xlabel='GT segment length (m)',ylabel=title,title=title+'; tangent GNSS approximation');ax.legend()
    save_fig(fig,figs/'rpe_bar.png')
    on_final=sorted([r for r in rows if r['trajectory']=='final' and r['run'].startswith('loop_on_r')],key=lambda r:r['ate_lever_2d_rmse_m'])
    representative=on_final[1]['run']
    for run in RUNS:
        align=all_metrics[run]['final']['se3'];matrix=np.eye(4);matrix[:3,:3]=align['R'];matrix[:3,3]=align['t']
        (out/run/'align_se3.json').write_text(json.dumps(dict(matrix_4x4=matrix.tolist(),R=align['R'],t=align['t'],
            source_frame='LIO-SAM odom/front_lidar pose coordinates (metres)',target_frame='GNSS local ENU (metres), first fix origin',
            convention='p_ENU = matrix_4x4 @ [p_odom,1]; rigid SE3, no scale, no lever arm'),indent=2))
    lines=[f'TASK-06 representative run: **{representative}** (median final 2D SE3+lever ATE RMSE among loop ON n=3).','', '# TASK-05 evaluation' ,'',f'GNSS accepted {gnss_stats["accepted"]}/{gnss_stats["total"]}; output frame ENU, metres.','',
           'SE3 has no scale fit. Joint lever fits are secondary in-sample diagnostics. Group std uses ddof=1 (n=3).', '',
           '| Run | Poses | SE3 2D ATE (m) | Lever 2D ATE (m) | SE3 3D ATE (m) | Lever 3D ATE (m) | Lever norm (m) | Endpoint vector error (m) |',
           '|---|---|---:|---:|---:|---:|---:|---:|']
    for r in rows: lines.append(f'| {r["run"]} | {r["trajectory"]} | {r["ate_se3_2d_rmse_m"]:.4f} | {r["ate_lever_2d_rmse_m"]:.4f} | {r["ate_se3_rmse_m"]:.4f} | {r["ate_lever_rmse_m"]:.4f} | {r["lever_norm_m"]:.3f} | {r["endpoint_error_m"]:.4f} |')
    lines+=['','## ON/OFF aggregate (mean ± sample std)','','| Group | Trajectory | Metric | Mean | Std | n |','|---|---|---|---:|---:|---:|']
    for r in aggregates:lines.append(f'| {r["group"]} | {r["trajectory"]} | {r["metric"]} | {r["mean"]:.5f} | {r["std_sample"]:.5f} | {r["n"]} |')
    lines+=['','## Map quality','','| Run | MME (nats) | MPV (m²) | Overlap median (m) | p95 (m) | >0.2 m ratio |','|---|---:|---:|---:|---:|---:|']
    for r in map_rows:lines.append(f'| {r["run"]} | {r["mme_nats"]:.5f} | {r["mpv_m2"]:.7f} | {r["overlap_median_m"]:.4f} | {r["overlap_p95_m"]:.4f} | {r["double_wall_ratio"]:.3f} |')
    lines+=['','## Loop factor validation','', '| Run | Recorded events | Current / previous keyframe | GT horizontal distance (m) | Verdict |','|---|---:|---|---:|---|']
    for r in loop_rows:lines.append(f'| {r["run"]} | {r["recorded_events"]} | {r["keyframe_current"]} / {r["keyframe_previous"]} | {r["gt_distance_m"]} | {r["classification"]} |')
    lines+=['','v3 records cumulative loop marker endpoints and receive times. Latest endpoints are matched to final keyframes; maximum matching error must be <=0.2 m. GT horizontal distance <2 m classifies a true positive; this proximity check alone does not prove the relative rotation is correct.',
            '', 'Final-vs-online ATE is reported for all ON runs; online already includes earlier loop corrections, so it cannot isolate ATE immediately before/after each factor.',
            '', 'RPE uses 2 m centered GNSS tangent yaw and flat roll/pitch; body/antenna frame mismatch and tangent at corners limit rotational interpretation. Overlapping segments are correlated.',
            '', 'Map MME/MPV: same 0.1 m ENU voxel, radius 0.3 m, at least 6 neighbors, sample covariance eigenvalue floor 1e-9 m². Exact GNSS XY bounding box; unbounded height. Eligible-neighbor fractions are in map_quality.csv.',
            '', 'Overlap uses first/last 15 s of GNSS time, clipped to available final pose support. No deskew. Both NN directions gated at 1 m; coverage fractions prevent interpreting a tiny overlap as a good whole map.',
            '', 'The even run uses only even scans. This is TASK-05 evaluation, not the held-out localization experiment TASK-05b.',
            '', f'evo maximum ATE difference: {max(r["evo_difference_m"] for r in rows):.3g} m.']
    (out/'summary.md').write_text('\n'.join(lines)+'\n')
    after=source_manifest()
    if before!=after: raise AssertionError('Protected source files changed during evaluation')
    import resource
    verification=dict(metrics_count=len(rows),map_count=len(map_rows),figure_count=len(list(figs.glob('*.png'))),
                      max_evo_difference_m=max(r['evo_difference_m'] for r in rows),protected_sources_unchanged=True,
                      wall_seconds=time.time()-started,peak_rss_mib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024,
                      loop_pair_validation='PASS: all recorded pairs evaluated',representative_run=representative)
    (out/'verification.json').write_text(json.dumps(verification,indent=2))
    print(json.dumps(verification,indent=2),flush=True)


if __name__=='__main__':main()

