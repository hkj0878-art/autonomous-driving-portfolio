Every product, including `gt_gnss_enu_tum.txt`, is under `results/eval/`.
This resolves TASKS.md's GT-path example in favor of its explicit output-only
restriction. Source bags, experiment directories and TASK-06 trees are untouched.
Individual CLIs use `python -m tools.eval.gnss_gt`, `traj_eval`,
`build_map_from_poses` and `map_quality`; see `--help`.

`build_map_from_poses` accepts all/even/odd zero-based scan indices. SLERP
interpolates rotations and linear interpolation translates scan headers;
there is no point deskew or pose extrapolation. NPZ stores xyz,
relative_time_s, stamp_s and count. Times are weighted voxel means, allowing
provenance through downsampling rather than pretending each voxel is an
original return. Overlap caches retain those fields for first/last windows.
Voxel merges are incremental and enforce a 3-million-voxel limit.

MME is differential Gaussian entropy in nats (negative values are valid).
MPV is the smallest sample-covariance eigenvalue in m². Both use radius
0.3 m, min 6 neighbors, floor 1e-9 m², all eligible 0.1 m voxel points.
Saved GlobalMap points are transformed into ENU before voxelization and
cropped to the same GNSS XY bounding box, with height unconstrained.
Coverage and eligible-neighbor fractions accompany each value.

Overlap NN statistics concatenate both directions, restricting each to
points within 1 m of the other cloud. The >0.2 m fraction is a discrepancy
proxy that includes different visibility and sampling, not a detector of
semantic double walls. Acquisition windows are the first/last 15 s of GNSS
time, intersected with final pose support.

RPE uses every matched start and the first end at or beyond each requested
GT distance, with actual distance as denominator. GNSS yaw comes from a 2 m
centered position tangent, roll/pitch zero. It includes antenna/body-origin
and body-heading effects and is an approximation, particularly at corners.

`loop_validation.csv` reports historical loop pair identities as unrecorded.
TASK-04 retained only event counts. Neither nearest GT positions nor
online pose discontinuities identify the actual factor endpoints. A future
run should save the `loop_edges` marker points with timestamp and keyframe
IDs; the existing source runs cannot support a true/false-positive verdict.
Final versus online ATE does not isolate a single loop insertion.

Joint lever estimation uses unbounded ordinary least squares over global
rotation, translation, and a 3D body-frame lever. Planar motion weakly
observes its vertical component; singular values and condition number are
recorded. Treat its improved in-sample ATE as diagnostic, not independent
validation of an estimated antenna offset. `|l| > 3 m` is flagged.
"""Local differential Gaussian entropy, minimum covariance eigenvalue and overlap."""
import argparse
from dataclasses import dataclass
import json
from pathlib import Path
import numpy as np
from scipy.spatial import cKDTree
from tools.pcd_to_tum import read_pcd
from .build_map_from_poses import voxel_reduce

@dataclass(frozen=True)
class MapConfig:
    voxel_m: float = 0.1
    radius_m: float = 0.3
    min_neighbors: int = 6
    covariance_floor_m2: float = 1e-9
    query_chunk: int = 2000
    double_wall_m: float = 0.2
    overlap_gate_m: float = 1.0


def read_map(path, r, t, bounds, cfg=MapConfig()):
    a=read_pcd(path)
    xyz=np.column_stack([a[k] for k in ('x','y','z')]).astype(float)
    xyz=xyz[np.isfinite(xyz).all(axis=1)]@np.asarray(r).T+np.asarray(t)
    mask=np.all((xyz[:,:2]>=bounds[0])&(xyz[:,:2]<=bounds[1]),axis=1)
    xyz=xyz[mask]
    if not len(xyz): raise ValueError('No map points inside GT XY bounding box')
    return voxel_reduce(np.column_stack((xyz,np.zeros((len(xyz),2)),np.ones(len(xyz)))),cfg.voxel_m)[:,:3]


def local_quality(xyz,cfg=MapConfig()):
    tree=cKDTree(xyz); entropy=[]; variance=[]
    for start in range(0,len(xyz),cfg.query_chunk):
        groups=tree.query_ball_point(xyz[start:start+cfg.query_chunk],cfg.radius_m,workers=1)
        for ids in groups:
            if len(ids)<cfg.min_neighbors: continue
            cov=np.cov(xyz[ids],rowvar=False,ddof=1)
            eigen=np.maximum(np.linalg.eigvalsh(cov),cfg.covariance_floor_m2)
            entropy.append(0.5*np.log((2*np.pi*np.e)**3*np.prod(eigen)))
            variance.append(eigen[0])
    if not entropy: raise ValueError('No neighborhoods with sufficient neighbors')
    return dict(mme_nats=float(np.mean(entropy)),mpv_m2=float(np.mean(variance)),
                eligible_points=len(entropy),total_points=len(xyz),eligible_fraction=len(entropy)/len(xyz),
                radius_m=cfg.radius_m,min_neighbors=cfg.min_neighbors,covariance_floor_m2=cfg.covariance_floor_m2,
                formula='MME=mean(0.5 ln((2 pi e)^3 det(C))); MPV=mean(lambda_min(C)), sample covariance; lower is locally sharper. Density/scene dependent.')


def overlap(a,b,cfg=MapConfig()):
    distances=[]; result={}
    for label,x,y in [('A_to_B',a,b),('B_to_A',b,a)]:
        d=cKDTree(y).query(x,k=1,workers=1)[0]
        inside=d<=cfg.overlap_gate_m
        selected=d[inside]
        if not len(selected): raise ValueError('Empty bidirectional overlap')
        result[label]=dict(total_points=len(d),overlap_points=int(inside.sum()),overlap_fraction=float(inside.mean()))
        distances.append(selected)
    d=np.concatenate(distances)
    result.update(median_m=float(np.median(d)),p95_m=float(np.percentile(d,95)),double_wall_ratio=float(np.mean(d>cfg.double_wall_m)),
                  threshold_m=cfg.double_wall_m,overlap_gate_m=cfg.overlap_gate_m,
                  note='Symmetric nearest neighbors restricted to <=1 m mutual spatial support per direction. >0.2 m is a discrepancy proxy, not a semantic wall classifier.')
    return result


if __name__=='__main__':
    p=argparse.ArgumentParser(); p.add_argument('--map',required=True); p.add_argument('--alignment',required=True)
    p.add_argument('--gt',required=True); p.add_argument('--out',required=True)
    a=p.parse_args(); align=json.loads(Path(a.alignment).read_text())['se3']; gt=np.loadtxt(a.gt)
    xyz=read_map(a.map,align['R'],align['t'],(gt[:,1:3].min(axis=0),gt[:,1:3].max(axis=0)))
    Path(a.out).write_text(json.dumps(local_quality(xyz),indent=2))
"""Streaming voxel map with pose SLERP, scan parity and acquisition-time provenance.

No per-point deskew: each scan uses its header pose. relative_time_s and stamp_s
are voxel means (not original individual returns). count weights allow incremental
voxel aggregation without changing centroids. Input bags and trajectories are read-only.
"""
import argparse
from pathlib import Path
import numpy as np
from scipy.spatial.transform import Rotation, Slerp
from rclpy.serialization import deserialize_message
from sensor_msgs.msg import PointCloud2
from .gnss_gt import bag_reader
from .traj_eval import load_tum

VOXEL_M = 0.1
MERGE_EVERY_SCANS = 20
MAX_VOXELS = 3_000_000


def voxel_reduce(rows, voxel=VOXEL_M):
    """Nx6: xyz, relative-time, header-stamp, weight. Weighted voxel means."""
    if voxel<=0: raise ValueError('Voxel size must be positive')
    if not len(rows): return np.empty((0,6))
    keys=np.floor(rows[:,:3]/voxel).astype(np.int64)
    _, inverse=np.unique(keys,axis=0,return_inverse=True)
    n=int(inverse.max())+1
    if n>MAX_VOXELS: raise MemoryError(f'Voxel budget exceeded ({n}); increase voxel size')
    weights=np.bincount(inverse,weights=rows[:,5],minlength=n)
    means=np.column_stack([np.bincount(inverse,weights=rows[:,k]*rows[:,5],minlength=n)/weights for k in range(5)])
    return np.column_stack((means,weights))


def cloud_rows(msg):
    names=['x','y','z','time']; fields={f.name:f for f in msg.fields}
    if not set(names)<=fields.keys(): raise ValueError('Cloud missing xyz/time')
    if any(fields[n].datatype!=7 or fields[n].count!=1 for n in names): raise ValueError('Expected float32 xyz/time')
    endian='>' if msg.is_bigendian else '<'
    dt=np.dtype(dict(names=names,formats=[endian+'f4']*4,
                     offsets=[fields[n].offset for n in names],itemsize=msg.point_step))
    a=np.ndarray((msg.height,msg.width),dtype=dt,buffer=msg.data,strides=(msg.row_step,msg.point_step)).reshape(-1)
    xyz=np.column_stack([a[n] for n in names[:3]])
    mask=np.isfinite(xyz).all(axis=1)&np.isfinite(a['time'])&(np.linalg.norm(xyz,axis=1)>0)
    return xyz[mask],a['time'][mask]


def build_map(bag, trajectory, scan_filter='all', voxel=VOXEL_M, windows=None, alignment=None):
    if scan_filter not in ('all','even','odd'): raise ValueError('Invalid scan filter')
    trajectory=np.asarray(trajectory)
    interp=Slerp(trajectory[:,0], Rotation.from_quat(trajectory[:,4:]))
    reader=bag_reader(bag,['/points_raw'])
    windows=windows or [(float(trajectory[0,0]),float(trajectory[-1,0]))]
    accumulated=[np.empty((0,6)) for _ in windows]; pending=[[] for _ in windows]
    scanned=0; used=[0]*len(windows)
    while reader.has_next():
        _,raw,_=reader.read_next()
        index=scanned; scanned+=1
        if scan_filter!='all' and index%2 != (0 if scan_filter=='even' else 1): continue
        msg=deserialize_message(raw,PointCloud2)
        t=msg.header.stamp.sec+msg.header.stamp.nanosec*1e-9
        if t<trajectory[0,0] or t>trajectory[-1,0]: continue
        targets=[i for i,(lo,hi) in enumerate(windows) if lo<=t<=hi]
        if not targets: continue
        xyz,relative=cloud_rows(msg)
        rotation=interp([t]).as_matrix()[0]
        translation=np.array([np.interp(t,trajectory[:,0],trajectory[:,k]) for k in range(1,4)])
        xyz=xyz@rotation.T+translation
        if alignment is not None:
            r,trans=alignment; xyz=xyz@np.asarray(r).T+np.asarray(trans)
        rows=voxel_reduce(np.column_stack((xyz,relative,np.full(len(xyz),t),np.ones(len(xyz)))),voxel)
        for i in targets:
            pending[i].append(rows); used[i]+=1
            if len(pending[i])>=MERGE_EVERY_SCANS:
                accumulated[i]=voxel_reduce(np.concatenate([accumulated[i],*pending[i]]),voxel); pending[i]=[]
    for i in range(len(windows)):
        if pending[i]: accumulated[i]=voxel_reduce(np.concatenate([accumulated[i],*pending[i]]),voxel)
        if not len(accumulated[i]): raise ValueError(f'No scans covered window {windows[i]}')
    return accumulated,dict(scans_read=scanned,scans_used=used,voxel_m=voxel,scan_filter=scan_filter,
                            deskew=False,relative_time='voxel weighted mean of original scan-relative seconds')


if __name__=='__main__':
    p=argparse.ArgumentParser(); p.add_argument('--bag',required=True); p.add_argument('--traj',required=True)
    p.add_argument('--out',required=True); p.add_argument('--scan-filter',choices=['all','even','odd'],default='all')
    p.add_argument('--voxel',type=float,default=VOXEL_M)
    a=p.parse_args(); maps,meta=build_map(a.bag,load_tum(a.traj),a.scan_filter,a.voxel)
    import json
    target=Path(a.out); target.parent.mkdir(parents=True,exist_ok=True)
    np.savez_compressed(target,xyz=maps[0][:,:3],relative_time_s=maps[0][:,3],stamp_s=maps[0][:,4],count=maps[0][:,5],metadata=json.dumps(meta))
