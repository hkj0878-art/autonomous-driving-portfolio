#!/usr/bin/env python3
"""Record online mapping poses and maximum cumulative loop marker edge count."""
import argparse
import json
import signal
import time
from pathlib import Path
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from nav_msgs.msg import Odometry
from rosgraph_msgs.msg import Clock
from visualization_msgs.msg import MarkerArray

class Recorder(Node):
    def __init__(self, directory):
        super().__init__('trajectory_recorder')
        self.directory=Path(directory); self.f=(self.directory/'odom_online_tum.txt').open('w',buffering=1)
        self.clock=None; self.lags=[]
        self.create_subscription(Clock,"/clock",self.tick,qos_profile_sensor_data)
        self.count=0; self.loops=0; self.first=None; self.last=None; self.last_wall=None
        self.create_subscription(Odometry,'/lio_sam/mapping/odometry',self.odom,qos_profile_sensor_data)
        self.create_subscription(MarkerArray,'/lio_sam/mapping/loop_closure_constraints',self.markers,10)
        self.create_timer(1.,self.status)
    def tick(self,m):
        self.clock=m.clock.sec+m.clock.nanosec*1e-9
    def odom(self,m):
        t=m.header.stamp.sec+m.header.stamp.nanosec*1e-9; p=m.pose.pose.position; q=m.pose.pose.orientation
        self.f.write(f'{t:.9f} {p.x:.9f} {p.y:.9f} {p.z:.9f} {q.x:.9f} {q.y:.9f} {q.z:.9f} {q.w:.9f}\n')
        if self.clock is not None: self.lags.append(self.clock-t)
        self.count+=1; self.first=t if self.first is None else self.first; self.last=t; self.last_wall=time.time()
    def markers(self,m):
        for marker in m.markers:
            if marker.ns=='loop_edges': self.loops=max(self.loops,len(marker.points)//2)
    def status(self):
        obj=dict(online_count=self.count,loop_events=self.loops,first_stamp=self.first,last_stamp=self.last,last_receive_wall=self.last_wall, max_sim_lag_s=max(self.lags,default=None), mean_sim_lag_s=sum(self.lags)/len(self.lags) if self.lags else None)
        tmp=self.directory/'recorder_status.tmp'; tmp.write_text(json.dumps(obj)); tmp.replace(self.directory/'recorder_status.json')

def main():
    p=argparse.ArgumentParser(); p.add_argument('directory'); args=p.parse_args()
    rclpy.init(); node=Recorder(args.directory)
    try: rclpy.spin(node)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException): pass
    finally:
        node.status(); node.f.close(); node.destroy_node()
        if rclpy.ok(): rclpy.shutdown()
if __name__=='__main__': main()
#!/usr/bin/env python3
"""Read PCL ASCII/binary (uncompressed) PointTypePose, convert Rz Ry Rx to TUM."""
import argparse
from pathlib import Path
import numpy as np

def read_pcd(path):
    with open(path, 'rb') as f:
        h = {}
        while True:
            line = f.readline()
            if not line:
                raise ValueError('Missing PCD DATA header')
            s = line.decode('ascii').strip().split()
            if not s or s[0].startswith('#'): continue
            h[s[0]] = s[1:]
            if s[0] == 'DATA': break
        counts = list(map(int, h.get('COUNT', ['1']*len(h['FIELDS']))))
        types = {('F',4):'<f4',('F',8):'<f8',('U',4):'<u4',('U',2):'<u2',('I',4):'<i4',('U',1):'u1'}
        dtype = np.dtype([(n, types[(t,int(z))], (c,)) if c != 1 else (n,types[(t,int(z))]) for n,t,z,c in zip(h['FIELDS'],h['TYPE'],h['SIZE'],counts)])
        n = int(h['POINTS'][0])
        if h['DATA'] == ['binary']:
            a = np.frombuffer(f.read(), dtype=dtype)
        elif h['DATA'] == ['ascii']:
            a = np.loadtxt(f, dtype=dtype, ndmin=1)
        else: raise ValueError('Unsupported compressed PCD')
        if len(a) != n: raise ValueError('PCD point count mismatch')
        return a

def pose_to_tum(a):
    required = ('x','y','z','roll','pitch','yaw','time')
    if not set(required).issubset(a.dtype.names): raise ValueError('Missing pose fields')
    r,p,y = [a[k].astype(float)/2 for k in ('roll','pitch','yaw')]
    cr,cp,cy,sr,sp,sy = np.cos(r),np.cos(p),np.cos(y),np.sin(r),np.sin(p),np.sin(y)
    q = np.column_stack((sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy, cr*cp*sy-sr*sp*cy, cr*cp*cy+sr*sp*sy))
    out = np.column_stack((a['time'],a['x'],a['y'],a['z'],q))
    if not np.isfinite(out).all() or len(out)<2 or (np.diff(out[:,0])<=0).any(): raise ValueError('Invalid/nonmonotonic poses')
    return out

def convert(source, target):
    a = pose_to_tum(read_pcd(source))
    np.savetxt(target,a,fmt='%.9f',header='timestamp tx ty tz qx qy qz qw')
    return a

if __name__ == '__main__':
    p=argparse.ArgumentParser(); p.add_argument('source'); p.add_argument('target'); args=p.parse_args()
    convert(args.source,args.target)

