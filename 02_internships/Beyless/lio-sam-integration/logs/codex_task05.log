    p=argparse.ArgumentParser(); p.add_argument('--traj',required=True); p.add_argument('--gt',required=True); p.add_argument('--out',required=True)
    a=p.parse_args(); evaluate(load_tum(a.traj),load_tum(a.gt),a.out)
